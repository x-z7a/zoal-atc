I
800
OBJ

# A green taxiway centreline light: X-Plane's own taxi_g, the light airport
# scenery uses, aimed back down the route at the aircraft following it
# (+Z is behind the instance's heading). The fixture is a 30 cm flush lens
# and is not lit itself: the light is the sprite, which X-Plane draws by day
# and by night.

TEXTURE taxi_lights.png
POINT_COUNTS 4 0 0 6

VT -0.150 0.030 -0.150 0 1 0 0.25 0.50
VT 0.150 0.030 -0.150 0 1 0 0.25 0.50
VT 0.150 0.030 0.150 0 1 0 0.25 0.50
VT -0.150 0.030 0.150 0 1 0 0.25 0.50

IDX 0
IDX 1
IDX 2
IDX 0
IDX 2
IDX 3

ATTR_no_cull
ATTR_shiny_rat 0.0
TRIS 0 6

LIGHT_NAMED taxi_g 0 0.08 0
LIGHT_NAMED taxi_g_halo 0 0.05 0
